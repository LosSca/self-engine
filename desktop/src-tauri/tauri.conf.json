{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Self-Reference Engine",
  "version": "0.5.0",
  "identifier": "com.lossca.selfengine",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "node scripts/stage-web.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Self-Reference Engine",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
