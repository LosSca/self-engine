# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# CLIProxyAPI
ANTHROPIC_PROXY_URL=http://127.0.0.1:8318
ANTHROPIC_PROXY_KEY=lunar-proxy-key
OPENAI_PROXY_URL=http://127.0.0.1:8318/v1
OPENAI_PROXY_KEY=lunar-proxy-key

# Neo4j (matches docker-compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lunar_password

# App
# Debug mode: enables verbose logging and auto-reload
DEBUG=false
# Local model (NInfer) — OpenAI-compatible server.
# Start it with E:\ninfer\start-local.ps1 (127.0.0.1:8094, --model-id qwen3.8-27b).
# Copy the key from E:\ninfer\api-key.txt into LOCAL_LLM_API_KEY.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8094/v1
LOCAL_LLM_MODEL=qwen3.8-27b
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONTEXT_WINDOW=49152
# Narration: auto = use the model when one is configured (the local NInfer
# server above counts, no cloud key needed), template = deterministic text.
ENGINE_NARRATOR=auto
# Which provider narration uses when ENGINE_NARRATOR is llm/auto.
# Leave empty to prefer the local server; set deepseek/openai/anthropic to
# force a cloud provider.
ENGINE_LLM_PROVIDER=
# Intent advisor: when the deterministic parser cannot map an utterance, ask a
# model for a *candidate* action. Off by default. Even when on, the suggestion
# is re-parsed and re-run through the rules engine, and a slow or broken model
# just means the normal rejection. ENGINE_INTENT_TIMEOUT is in seconds.
ENGINE_INTENT_ADVISOR=0
ENGINE_INTENT_TIMEOUT=3.0
# State-mutating debug endpoints (rollback, repair). When unset they follow
# DEBUG above, so a production install does not expose them. Read-only debug
# views (state, diagnostics, snapshots, diffs) stay available either way.
ENGINE_DEBUG_TOOLS=
