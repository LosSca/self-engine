# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# CLIProxyAPI（可选）。留空就直连上面那三个官方接口；只有你自己起了 proxy/ 里的
# 本地代理时才需要填。身份验证与启动方式见 proxy/README.md。
# proxy/cliproxyapi/config.yaml 里的 api-keys 只是占位符，先换成你自己的随机串，
# 再把同一个值填到这里；两处不一致代理会直接 401。
ANTHROPIC_PROXY_URL=
ANTHROPIC_PROXY_KEY=
OPENAI_PROXY_URL=
OPENAI_PROXY_KEY=

# Neo4j（可选，只用于图谱镜像）。不设 NEO4J_PASSWORD 就完全跳过图谱，
# 引擎、API 和界面都照常工作。自己起 Neo4j 时把下面的默认密码换掉。
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# App
# 后端访问口令（可选）。留空 = 不校验，本机任何进程都能直接调用 API。
# 只要不是只给本机用（--host 0.0.0.0 / --mobile / 放公网），就应该设成一段随机串：
# 否则同一网络里任何人都能读写存档、切换模型、消耗你的 API 额度。
# 设置后所有 /api 请求都要带 Authorization: Bearer <token>（或 x-api-token: <token>），
# health 探针除外。注意：桌面壳与前端目前不带这个头，设了它就要自己注入。
API_TOKEN=
# 额外允许的跨域来源（逗号分隔）。内置只有 localhost/127.0.0.1 的 5173、4173；
# 桌面壳、自定义端口、反向代理域名要写在这里。
LUNAR_CORS_ORIGINS=
# Debug mode: enables verbose logging and auto-reload
DEBUG=false
# 自定义 OpenAI 兼容供应商：任何说 OpenAI chat-completions 方言的服务。
# 填了 BASE_URL 与 API_KEY 后，设置面板才会出现「自定义兼容接口」选项，
# 模型名在面板里填（例如 deepseek-v4.1-flash）。密钥只留在本机 .env。
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Local model (NInfer) — OpenAI-compatible server.
# 任何 OpenAI 兼容的本地推理服务都行（llama.cpp server、Ollama、vLLM、NInfer…）。
# LOCAL_LLM_BASE_URL 留空即视为“没有本地模型”，叙事退回云端或模板。
# 密钥按你所用服务的实际要求填；不需要鉴权的服务留空即可。
LOCAL_LLM_BASE_URL=http://127.0.0.1:8094/v1
LOCAL_LLM_MODEL=qwen3.8-27b
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONTEXT_WINDOW=49152
# Narration: auto = use the model when one is configured (the local NInfer
# server above counts, no cloud key needed), template = deterministic text.
ENGINE_NARRATOR=auto
# Which provider narration uses when ENGINE_NARRATOR is llm/auto.
# Leave empty to prefer the local server; set deepseek/openai/anthropic to
# force a cloud provider.
ENGINE_LLM_PROVIDER=
# Intent advisor: when the deterministic parser cannot map an utterance, ask a
# model for a *candidate* action. Off by default. Even when on, the suggestion
# is re-parsed and re-run through the rules engine, and a slow or broken model
# just means the normal rejection. ENGINE_INTENT_TIMEOUT is in seconds.
ENGINE_INTENT_ADVISOR=0
ENGINE_INTENT_TIMEOUT=3.0
# State-mutating debug endpoints (rollback, repair). When unset they follow
# DEBUG above, so a production install does not expose them. Read-only debug
# views (state, diagnostics, snapshots, diffs) stay available either way.
ENGINE_DEBUG_TOOLS=
# Knowledge-graph mirror: after a turn commits, the prose that was actually
# shown is written to Neo4j as a Graphiti episode (fire and forget; a mirror
# that is down can never roll a turn back). Requires NEO4J_PASSWORD; with no
# password nothing is attempted. Set to 0 to keep Neo4j completely quiet.
ENGINE_GRAPH_MIRROR=1
